# Production server configuration
NODE_ENV=production
HOST=127.0.0.1
PORT=5173
ORIGIN=https://shiori.example.com
SHIORI_DATA_DIRECTORY=/srv/shiori/data
SHIORI_SETUP_TOKEN=replace-with-a-random-secret-of-at-least-32-bytes

# The Node adapter otherwise accepts only 512 KiB request bodies. This must accommodate a 20 MB trip backup.
BODY_SIZE_LIMIT=20M

# Trust the one Caddy proxy that is bound to the same host. Caddy supplies an unspoofed X-Forwarded-For value.
ADDRESS_HEADER=x-forwarded-for
XFF_DEPTH=1

# Optional: AeroDataBox RapidAPI key for Google Flights schedule enrichment.
# Get the key from https://rapid.aerodatabox.com/, then restart Shiori after adding it.
AERODATABOX_API_KEY=replace-with-your-aerodatabox-api-key

# Alternatively, use a direct AeroDataBox subscription instead of RapidAPI.
# AERODATABOX_DIRECT_API_KEY=replace-with-your-direct-aerodatabox-api-key

# Optional: shared Google API key for all Google integrations below. Enable the required APIs and billing
# for this key in Google Cloud, then restart Shiori after adding it. Domain-specific keys can override it.
GOOGLE_API_KEY=replace-with-your-google-api-key

# Optional: Google Places API (New) key that overrides GOOGLE_API_KEY for Places lookups.
# GOOGLE_PLACES_API_KEY=replace-with-your-google-places-api-key

# Optional: Google Knowledge Graph Search API key that overrides GOOGLE_API_KEY for hotel entity lookups.
# GOOGLE_KNOWLEDGE_GRAPH_API_KEY=replace-with-your-google-knowledge-graph-api-key

# Optional: per-server-process limit for billable Google Places requests in one UTC month.
# The default is 4,500, leaving headroom beneath the 5,000 monthly free cap for Places Text Search Pro.
# Set a matching Google Cloud quota and billing alert because this defensive limit resets if the server restarts.
# GOOGLE_PLACES_MONTHLY_LIMIT=4500

# Optional: Google Routes API key that overrides GOOGLE_API_KEY for transit directions.
# GOOGLE_ROUTES_API_KEY=replace-with-your-google-routes-api-key

# Optional: Google Time Zone API key that overrides GOOGLE_API_KEY for local-time transit links.
# GOOGLE_TIME_ZONE_API_KEY=replace-with-your-google-time-zone-api-key
